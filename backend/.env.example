PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Primary: Gemma hosted on Google AI Studio (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMMA_HOSTED_MODEL=gemma-4-26b-a4b-it
GEMMA_HOSTED_FALLBACK_MODEL=gemma-4-31b-it

# Fallback: Gemma running locally via Ollama (ollama pull gemma3:4b)
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
GEMMA_LOCAL_MODEL=gemma3:4b

# AI tuning
# Gemma 4 reasoning depth: minimal | low | high (minimal is ~3x faster)
GEMMA_THINKING=minimal
# Timeouts per call, in ms (hosted / local Ollama)
AI_TIMEOUT_MS=90000
AI_LOCAL_TIMEOUT_MS=180000
# Cache identical AI requests for 6 h (saves quota during demo rehearsals): on | off
AI_CACHE=on
# true = print raw model output when validation fails (dev only)
AI_DEBUG=false

# Optional: MongoDB Atlas. Leave empty to use the in-memory store.
MONGODB_URI=
